# Copy this file to .env and replace every placeholder. .env is gitignored.
# Authenticated Postgres connection used by the FastAPI asyncpg pool. The role
# must be able to read the RLS-protected tracks and stations tables.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Direct Supabase PostgreSQL connection used by scripts/seed_supabase.py.
# Keep sslmode=require for hosted projects. Never commit the real password.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Optional stable Fly app name. If omitted, `fly launch` asks for one when the
# project has no fly.toml yet.
FLY_APP=bahnopticon-backend
