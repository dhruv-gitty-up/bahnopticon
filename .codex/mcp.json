{
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "env": {"npm_config_cache": ".mcp-cache/npm"}
    },
    "postgres": {
      "command": "bash",
      "args": ["scripts/run_postgres_mcp.sh"]
    },
    "fetch": {
      "command": "uvx",
      "args": ["--with", "mcp<2", "mcp-server-fetch"]
    },
    "fly": {
      "command": "flyctl",
      "args": ["mcp", "server"]
    }
  }
}
