# Copy to frontend/.env.local for local development.
# Browser API requests use this same-origin prefix; Vite removes it when proxying.
# VITE_ variables are public in the browser bundle: never put credentials here.
VITE_API_URL=/api
# Server-side Vite proxy target. This value is not exposed to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000
